# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public origin of the deployment. Used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL="https://www.sonumalik.example"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Database (managed PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sm_portfolio?schema=public&sslmode=require"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# 32+ random bytes, base64 or hex. Generate: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_48"
# Session lifetime in seconds (default 8 hours).
AUTH_SESSION_TTL="28800"

# Bootstrap super admin, consumed once by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Site Administrator"

# ---------------------------------------------------------------------------
# Outbound email (inquiry notifications)
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Sonu Malik Website <no-reply@example.com>"
# Where new-inquiry notifications are delivered.
INQUIRY_NOTIFY_TO=""
# Send an acknowledgement to the person who submitted the form.
INQUIRY_SEND_ACK="true"

# ---------------------------------------------------------------------------
# Privacy / analytics
# ---------------------------------------------------------------------------
# Salt used to derive rotating, non-reversible visitor hashes. Never expose.
ANALYTICS_IP_SALT="CHANGE_ME_random_string"
# Set to "false" to disable first-party analytics collection entirely.
NEXT_PUBLIC_ANALYTICS_ENABLED="true"

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# "local" writes to ./public/uploads (dev only). Use object storage in production.
UPLOAD_DRIVER="local"
UPLOAD_MAX_BYTES="10485760"
